# Godot
.godot/
export_presets.cfg.bak

# Web build output — regenerate with the command in DEPLOY.md
build/

# Editor / OS noise
*.tmp
Thumbs.db

# Local tool config — NOT for version control.
# .codex/config.toml holds a plaintext PixelLab API key, and settings.local.json
# is this machine's own permission list. Neither belongs in a shared history.
.codex/
.claude/settings.local.json

# Graphics-driver logs that appear in the project root on Windows.
NVIDIA Corporation/

# Screenshots and probe output. Regenerate with the tools in tools/ -- these are
# 20 MB of pictures OF the game, not part of it, and the same reasoning that
# keeps them out of the web export (exclude_filter in export_presets.cfg) keeps
# them out of the history.
output/
tmp/
