; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kaalaman sa Halalan"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

; Godot defaults the web platform to "Sample" playback (1) while desktop uses
; "Stream" (0). The two are different code paths, and Sample does not carry the
; bus routing this game relies on -- every player is assigned to a "Music" or
; "SFX" bus that AudioManager creates at RUNTIME via AudioServer.add_bus().
; The result was a build that was audible on desktop and completely silent in
; the browser. Forcing Stream puts the web export on the same path as desktop.
; Costs some audio latency on web, which a turn-based word game will not feel.
general/default_playback_type.web=0

[autoload]

WordValidator="*res://scripts/word_validator.gd"
GameState="*res://scripts/game_state.gd"
Audio="*res://scripts/audio_manager.gd"
QuestionBank="*res://scripts/question_bank.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="klhgamefinal"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
